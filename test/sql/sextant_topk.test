# name: test/sql/sextant_topk.test
# description: ORDER BY array_distance LIMIT k optimizer rewrite -> sextant index scan
# group: [sql]

require sextant

load __TEST_DIR__/sextant_topk.db

# 8 well-separated clusters (0.3 apart, 0.02 noise), 250 rows each — same
# fixture as sextant_scan.test so row sets are directly comparable.
statement ok
CREATE TABLE t AS SELECT list_transform(range(32), j -> ((rowid*7919 + j*104729) % 1009)::FLOAT/1009.0*0.02 + ((rowid % 8)::FLOAT*0.3))::FLOAT[32] AS v FROM range(2000) tbl(rowid)

statement ok
CREATE INDEX idx ON t USING sextant (v) WITH (path = 'topk.tree')

# The rewrite serves natural ANN SQL: top-20 for the cluster-3 center
# must all be cluster-3 rows.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 8 != 3
----
0

# Near-zero-norm cluster regression: q=0.1's true neighbors are the
# cluster-0 rows (v ≈ noise only). Before the ||x_hat||^2 sweep bias the
# raw scan ranked by -q.x_hat (IP surrogate) and buried them behind
# higher-norm clusters; the rewritten plan must return cluster-0 rows.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.1::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 8 != 0
----
0

# Same rows as the explicit engine search (set parity, k=50).
query I
WITH nat AS (SELECT rowid FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 50),
sx AS (SELECT row_id FROM sextant_query('t', 'idx', list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32], 50))
SELECT count(*) FROM (SELECT rowid FROM nat EXCEPT SELECT row_id::BIGINT FROM sx)
----
0

# The kept TopN re-sorts the few result rows by the exact expression:
# displayed distances ascend exactly.
query I
SELECT count(*) AS unordered FROM (SELECT array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) AS d, lag(d) OVER () AS prev FROM (SELECT v FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 50)) WHERE prev IS NOT NULL AND d < prev
----
0

# Full-row fetch through the rewrite (all table columns by rowid).
query I
SELECT count(*) AS bad FROM (SELECT rowid, v FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 8 != 3
----
0

# DESC is not rewritten (exact semantics kept) but must still work.
query I
SELECT count(*) FROM (SELECT rowid FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) DESC LIMIT 20)
----
20

# OFFSET (TopN window) is not rewritten but must still work.
query I
SELECT count(*) FROM (SELECT rowid FROM t ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 5 OFFSET 3)
----
5

# A predicate on rowid (not an engine filter column) still blocks the
# rewrite; exact semantics kept.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM t WHERE rowid % 8 = 3 ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 8 != 3
----
0

# ---- Filtered top-k: WHERE clauses over engine filter columns are pushed
# ---- into sextant_search_filtered (exact SQL semantics kept by a
# ---- re-injected filter above the scan).
statement ok
CREATE TABLE f AS SELECT list_transform(range(32), j -> ((rowid*7919 + j*104729) % 1009)::FLOAT/1009.0*0.02 + ((rowid % 8)::FLOAT*0.3))::FLOAT[32] AS v, CASE WHEN rowid % 500 = 499 THEN NULL ELSE 'cat_' || (rowid % 4)::VARCHAR END AS category, (2000 + (rowid % 10))::INTEGER AS year FROM range(2000) tbl(rowid)

statement ok
CREATE INDEX fidx ON f USING sextant (v) WITH (path = 'topk_filter.tree', filter_cols = 'category,year')

# Conjunctive string EQ + numeric range: every result is a cluster-3 row.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM f WHERE category = 'cat_3' AND year >= 2000 ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 8 != 3
----
0

# Selective numeric EQ still fills k (the engine sees the predicate).
query I
SELECT count(*) FROM (SELECT rowid FROM f WHERE year = 2009 ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20)
----
20

# String IN list.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM f WHERE category IN ('cat_3', 'cat_7') ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 4 != 3
----
0

# Numeric IN list.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM f WHERE year IN (2003, 2013) ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 10 != 3
----
0

# NEQ with NULLs in the filter column: SQL excludes NULL rows — the
# exact re-filter must keep them out of the result.
query I
SELECT count(*) AS bad FROM (SELECT rowid, category FROM f WHERE category != 'cat_1' ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE category IS NULL OR category = 'cat_1'
----
0

# IS NULL is served as an engine predicate on nullable trees (no exact
# re-filter). Recall is approximate like any ANN top-k: every returned
# row must be a NULL-category row, but the engine may return fewer than
# all 4 when the probe budget runs out.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM f WHERE category IS NULL ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 500 != 499
----
0

query I
SELECT count(*) >= 1 AND count(*) <= 4 FROM (SELECT count(*) FROM (SELECT rowid FROM f WHERE category IS NULL ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20))
----
true

# IS NOT NULL composed with a numeric predicate.
query I
SELECT count(*) AS bad FROM (SELECT rowid FROM f WHERE category IS NOT NULL AND year = 2003 ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 10 != 3 OR rowid % 500 = 499
----
0

# Bool filter column + BETWEEN-shaped range (GE+LE conjunction).
statement ok
CREATE TABLE g AS SELECT list_transform(range(32), j -> ((rowid*7919 + j*104729) % 1009)::FLOAT/1009.0*0.02 + ((rowid % 8)::FLOAT*0.3))::FLOAT[32] AS v, (rowid % 2 = 0) AS even, (rowid % 10)::INTEGER AS dec FROM range(2000) tbl(rowid)

statement ok
CREATE INDEX gidx ON g USING sextant (v) WITH (path = 'topk_bool.tree', filter_cols = 'even,dec')

query I
SELECT count(*) AS bad FROM (SELECT rowid, dec FROM g WHERE even AND dec BETWEEN 3 AND 6 ORDER BY array_distance(v, list_transform(range(32), j -> 0.9::FLOAT)::FLOAT[32]) LIMIT 20) WHERE rowid % 2 != 0 OR dec < 3 OR dec > 6
----
0
